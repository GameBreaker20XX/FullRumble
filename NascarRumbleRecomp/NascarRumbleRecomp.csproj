<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FullRumble</AssemblyName>
    <RootNamespace>FullRumble</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\NascarRumbleRecompResources\icon\FullRumble.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../thirdparty/RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    <ProjectReference Include="../thirdparty/RecompOne/RecompOne.Recompiler/RecompOne.Recompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NascarRumbleRecomp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="FullRumble.ReleaseName" Value="$(ReleaseName)" />
    <Content Include="../NascarRumbleRecompLib/config/nascar.json"
             Link="recompile/config/nascar.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../NascarRumbleRecompLib/config/nascar_funcmap.json"
             Link="recompile/config/nascar_funcmap.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../NascarRumbleRecompLib/src/**/*.cs"
             Link="recompile/src/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
