# Disc images and saves (never committed, never shipped)
*.bin
*.cue
*.iso
*.img
*.mdf
*.mds
*.chd
*.sav
*.mcd

# Game-derived and generated output (produced on the player's machine only)
generated/
private/
recompiled/
ppc/

# The copy of the player's own disc that setup makes at first run
/disc/
*.part

# Build output
bin/
obj/
out/
publish/
*.user

# Local tooling
.vs/
.idea/
*.log
__pycache__/
*.pyc

# Player-local runtime configuration written next to the working directory
/settings.json
/interface.ini
/launcher.json
